{
  "name": "@sverka/ui",
  "version": "0.1.0",
  "description": "Sverka UI — local web dashboard for viewing SARIF findings and run results",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sverka-dev/sverka",
    "directory": "packages/ui"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sverka/verification": "workspace:*",
    "@sverka/sarif-viewer-web": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
