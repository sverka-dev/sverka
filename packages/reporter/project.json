{
  "name": "reporter",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsdown",
        "cwd": "packages/reporter"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run vitest run --passWithNoTests",
        "cwd": "packages/reporter"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run eslint src",
        "cwd": "packages/reporter"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit",
        "cwd": "packages/reporter"
      }
    },
    "packlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/publint",
        "cwd": "packages/reporter"
      }
    },
    "typelint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../node_modules/.bin/attw --pack . --profile esm-only --format table",
        "cwd": "packages/reporter"
      }
    },
    "lint:sarif": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p reports && ../../node_modules/.bin/eslint src -f @microsoft/eslint-formatter-sarif -o reports/eslint.sarif || true",
        "cwd": "packages/reporter"
      }
    }
  }
}
