{
  "name": "@sverka/reporter",
  "version": "0.2.1",
  "description": "Sverka reporter — render engine events, findings, and policy verdicts",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sverka-dev/sverka.git",
    "directory": "packages/reporter"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@sverka/runtime": "workspace:*",
    "@sverka/verification": "workspace:*",
    "@sverka/workflow": "workspace:*",
    "ink": "7.1.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsdown": "^0.23.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
