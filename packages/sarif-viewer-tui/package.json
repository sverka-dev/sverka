{
  "name": "@sverka/sarif-viewer-tui",
  "version": "0.1.0",
  "description": "Sverka SARIF viewer TUI — standalone Ink-based terminal viewer for SARIF files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sverka-dev/sverka",
    "directory": "packages/sarif-viewer-tui"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "sarif-viewer-tui": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ink": ">=5 <8",
    "react": ">=19.2.0 <20"
  },
  "dependencies": {
    "@sverka/verification": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "ink": "7.1.1",
    "ink-testing-library": "4.0.0",
    "react": "19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
