{
  "name": "@sverka/sarif-viewer-tui",
  "version": "0.2.35",
  "description": "Sverka SARIF viewer TUI — standalone Ink-based terminal viewer for SARIF files",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sverka-dev/sverka.git",
    "directory": "packages/sarif-viewer-tui"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "sarif-viewer-tui": "dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ink": ">=5 <9",
    "react": ">=19.2.0 <20"
  },
  "dependencies": {
    "@sverka/verification": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "ink": "^8.0.0",
    "react": "19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}
