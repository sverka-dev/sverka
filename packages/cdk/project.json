{
  "name": "cdk",
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "bun run tsdown", "cwd": "packages/cdk" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "bun run vitest run --passWithNoTests", "cwd": "packages/cdk" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "bun run eslint src", "cwd": "packages/cdk" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "bun run tsc --noEmit", "cwd": "packages/cdk" } }
  }
}
