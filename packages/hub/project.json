{
  "name": "hub",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsdown",
        "cwd": "packages/hub"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run vitest run --passWithNoTests",
        "cwd": "packages/hub"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run eslint src",
        "cwd": "packages/hub"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit",
        "cwd": "packages/hub"
      }
    },
    "packlint": {},
    "typelint": {},
    "lint:sarif": {}
  }
}
