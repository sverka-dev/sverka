{
  "name": "@sverka/hub",
  "version": "0.2.16",
  "description": "Sverka hub — self-hosted remote run hub (cache + history + findings)",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sverka-dev/sverka.git",
    "directory": "packages/hub"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sverka/sarif-viewer-web": "workspace:*",
    "@sverka/ui": "workspace:*",
    "@sverka/verification": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
