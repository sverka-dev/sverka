{
  "name": "@sverka/playground",
  "version": "0.2.46",
  "description": "Sverka Playground — browser sandbox for building and running check pipelines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sverka-dev/sverka.git",
    "directory": "packages/playground"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "dist-web",
    "index.html"
  ],
  "scripts": {
    "build": "tsdown",
    "build:web": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sverka/sarif-viewer-web": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@sverka/workflow": "workspace:*",
    "jsdom": "^30.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  }
}
