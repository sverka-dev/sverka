{
  "name": "engine-native",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsdown",
        "cwd": "packages/engine-native"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run vitest run --passWithNoTests",
        "cwd": "packages/engine-native"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run eslint src --ext .ts",
        "cwd": "packages/engine-native"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit",
        "cwd": "packages/engine-native"
      }
    }
  }
}
