{
  "name": "compiler-earthly",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsdown",
        "cwd": "packages/compiler-earthly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run vitest run --passWithNoTests",
        "cwd": "packages/compiler-earthly"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run oxlint src",
        "cwd": "packages/compiler-earthly"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit",
        "cwd": "packages/compiler-earthly"
      }
    }
  }
}
