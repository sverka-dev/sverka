{
  "name": "@sverka/compiler",
  "version": "0.1.0",
  "description": "Sverka compiler — compile Definition Graphs to GitHub Actions, GitLab CI, Temporal, Dagger, Inngest, Drone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sverka-dev/sverka",
    "directory": "packages/compiler"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sverka/workflow": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
