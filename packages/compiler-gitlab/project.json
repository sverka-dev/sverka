{
  "name": "compiler-gitlab",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsdown",
        "cwd": "packages/compiler-gitlab"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run vitest run",
        "cwd": "packages/compiler-gitlab"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run eslint src --ext .ts",
        "cwd": "packages/compiler-gitlab"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit",
        "cwd": "packages/compiler-gitlab"
      }
    }
  }
}
