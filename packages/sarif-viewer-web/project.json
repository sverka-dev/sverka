{
  "name": "sarif-viewer-web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsdown",
        "cwd": "packages/sarif-viewer-web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run vitest run --passWithNoTests",
        "cwd": "packages/sarif-viewer-web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run eslint src",
        "cwd": "packages/sarif-viewer-web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tsc --noEmit",
        "cwd": "packages/sarif-viewer-web"
      }
    }
  }
}
