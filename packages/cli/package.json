{
  "name": "sverka",
  "version": "0.2.48",
  "description": "Sverka CLI — validate, plan, run, and compile workflows",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sverka-dev/sverka.git",
    "directory": "packages/cli"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "sverka": "dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sverka/compiler": "workspace:*",
    "@sverka/reporter": "workspace:*",
    "@sverka/runtime": "workspace:*",
    "@sverka/sarif-viewer-tui": "workspace:*",
    "@sverka/sarif-viewer-web": "workspace:*",
    "@sverka/sdk": "workspace:*",
    "@sverka/storage": "workspace:*",
    "@sverka/ui": "workspace:*",
    "@sverka/verification": "workspace:*",
    "@sverka/workflow": "workspace:*",
    "chokidar": "^6.0.0",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@sverka/hub": "workspace:*"
  }
}
