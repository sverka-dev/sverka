    "@sverka/engine-native": "workspace:*",
    "@sverka/runtime-host": "workspace:*",
    "@sverka/runtime-docker": "workspace:*",
    "@sverka/checks": "workspace:*",
    "@sverka/findings": "workspace:*",
    "@sverka/policy": "workspace:*",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "tsdown": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
