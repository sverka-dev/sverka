{
  "name": "@sverka/cli",
  "version": "0.1.0",
  "description": "Sverka CLI — validate, plan, run, and compile workflows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sverka-dev/sverka",
    "directory": "packages/cli"
  },
  "homepage": "https://sverka.dev",
  "bugs": "https://github.com/sverka-dev/sverka/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "sverka": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sverka/workflow": "workspace:*",
    "@sverka/sdk": "workspace:*",
    "@sverka/runtime": "workspace:*",
    "@sverka/verification": "workspace:*",
    "@sverka/compiler": "workspace:*",
    "@sverka/reporter": "workspace:*",
    "@sverka/sarif-viewer-tui": "workspace:*",
    "@sverka/sarif-viewer-web": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "yargs": "^18.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "tsdown": "^0.22.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
