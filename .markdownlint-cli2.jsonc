{
  // Rule config lives in .markdownlint.json — a per-directory
  // .markdownlint.* file replaces the "config" here entirely.
  "globs": [
    "*.md",
    "engdocs/**/*.md",
    "specs/**/*.md",
    "website/**/*.md",
    "packages/*/README.md",
  ],
  "ignores": [
    "CHANGELOG.md", // generated by release automation
    "specs/legacy/**", // archived specs — frozen, not maintained
    "AGENTS.md", // managed Beads/Codex blocks duplicate headings by design
    "CLAUDE.md", // managed Beads block — same rationale as AGENTS.md
    "website/**/_*.md", // Starlight template partials, not real pages
    "vendor/**",
    "**/node_modules/**",
    ".beads/**",
    ".bun/**",
    "tmp/**",
    "**/dist/**",
  ],
}
