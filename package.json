{
  "name": "sverka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "nx run-many --target=build --all --exclude=skills-*,pack-skills-*",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "lint:sarif": "out=$(nx run-many -t lint:sarif --exclude=skills-*,pack-skills-* 2>&1) || { printf \"%s\\n\" \"$out\" >&2; exit 1; }; f=$(ls packages/*/reports/eslint.sarif); n=$(ls -d packages/*/ | wc -l); m=$(echo \"$f\" | wc -l); [ \"$m\" -eq \"$n\" ] || { echo \"sarif coverage: $m/$n package reports — a packages/* dir lacks a lint:sarif target\" >&2; exit 1; }; echo \"$f\" | xargs jq -s \"{version:\\\"2.1.0\\\",\\\"\\$schema\\\":.[0][\\\"\\$schema\\\"],runs:[.[].runs[]]}\"",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many --target=typecheck --all",
    "clean": "nx reset",
    "lint:spell": "cspell lint --no-progress",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:deps": "knip",
    "lint:attw": "nx run-many -t typelint --exclude=skills-*,pack-skills-*",
    "lint:pack": "nx run-many -t packlint --exclude=skills-*,pack-skills-*",
    "lint:actionlint": "b=\"$(go env GOBIN)\"; [ -n \"$b\" ] || b=\"$(go env GOPATH)/bin\"; go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 && \"$b/actionlint\" .github/workflows/*.yml"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@nx-devkit/prepare-for-release": "0.1.22",
    "@nx-devkit/skill": "0.1.19",
    "@nx-devkit/skillspector": "0.1.19",
    "@nx-devkit/typescript": "0.2.18",
    "@nx/js": "^23.2.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "sverka": "workspace:*",
    "@sverka/workflow": "workspace:*",
    "@types/node": "26.5.1",
    "cspell": "10.3.4",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "markdownlint-cli2": "0.23.3",
    "nx": "^23.2.1",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "secretlint": "13.0.6",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "smol-toml": "^1.8.0",
    "fast-uri": "^3.1.7",
    "axios": "1.20.0",
    "brace-expansion": "^5.0.11",
    "minimatch@3": {
      "brace-expansion": "^1.1.12"
    }
  }
}
