{
  "name": "sverka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "nx run-many --target=build --all --exclude=skills-*,pack-skills-*",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "lint:sarif": "eslint packages/*/src -f @microsoft/eslint-formatter-sarif",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many --target=typecheck --all",
    "clean": "nx reset",
    "build:nx-plugins": "bun scripts/build-nx-plugins.ts",
    "patch:nx": "bun scripts/patch-nx-submodule.ts",
    "docs:api": "typedoc --options typedoc.json && bun scripts/fix-api-docs.ts",
    "lint:spell": "cspell lint --no-progress",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:deps": "knip",
    "lint:attw": "for d in packages/*/; do echo \"== $d\"; (cd \"$d\" && attw --pack . --profile esm-only --format table) || exit 1; done"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@nx-devkit/prepare-for-release": "file:./vendor/nx.ts/packages/prepare-for-release",
    "@nx-devkit/skill": "file:./vendor/nx.ts/packages/skill",
    "@nx-devkit/skillspector": "file:./vendor/nx.ts/packages/skillspector",
    "@nx-devkit/typescript": "file:./vendor/nx.ts/packages/typescript-preset",
    "@nx/js": "^23.2.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@sverka/workflow": "workspace:*",
    "@types/node": "26.5.1",
    "cspell": "10.3.3",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "markdownlint-cli2": "0.23.3",
    "nx": "^23.2.1",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "secretlint": "13.0.5",
    "tsdown": "0.23.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.2",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "smol-toml": "^1.8.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.7"
  }
}
