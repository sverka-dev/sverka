{
  "name": "sverka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "clean": "nx reset",
    "format": "biome format --write",
    "format:check": "biome format",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "^21.0.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
