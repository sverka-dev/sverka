---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

interface Step {
  stepId: string;
  status: string;
  durationMs?: number;
  error?: string;
  stdout?: string;
  stderr?: string;
  exitCode?: number;
}
interface RunData {
  status: string;
  planId?: string;
  steps?: Step[];
  durationMs?: number;
}
interface Capture {
  id: string;
  exitCode: number;
  run?: { data?: RunData; durationMs?: number };
  outputTail?: string;
  reportFile?: string;
}
interface PipelineData {
  generatedAt: string;
  commit: string;
  self: Capture;
  examples: Capture[];
}
// The data file is generated by `bun run docs:pipeline` before `astro
// build`. `import.meta.glob` tolerates its absence (empty result, no
// build failure) so plain `astro dev`/`check` still work.
const modules = import.meta.glob<{ default: PipelineData }>(
  "../generated/pipelines.json",
  { eager: true },
);
const data: PipelineData | null =
  Object.values(modules)[0]?.default ?? null;

const fmtMs = (ms?: number): string =>
  ms === undefined ? "—" : ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`;
const chip = (status?: string): string => {
  if (status === "succeeded" || status === "success") return "ok";
  if (status === "failed" || status === "failure" || status === "error")
    return "fail";
  return "skip"; // skipped, cancelled, unknown — neutral
};
const overall = (c: Capture): string =>
  c.run?.data?.status ?? (c.exitCode === 0 ? "success" : "failure");
// Reports are plain files in public/pipeline-reports/ — prefix with the
// configured base (Starlight only prefixes its own routes).
const reportHref = (c: Capture): string | undefined =>
  c.reportFile
    ? `${import.meta.env.BASE_URL}pipeline-reports/${c.reportFile}`
    : undefined;
---

<StarlightPage frontmatter={{ title: "Pipeline status" }}>
  {
    data === null ? (
      <p class="meta">
        No pipeline data — run <code>bun run docs:pipeline</code> to
        generate it (requires built workspace deps).
      </p>
    ) : null
  }
  {data && (
  <>
  <p class="meta">
    Generated {new Date(data.generatedAt).toUTCString()} · commit
    <code>{data.commit || "local"}</code>
  </p>

  <h2>This repository</h2>
  <p class="meta">
    Live <code>sverka run --format json</code> of the repo's own
    <code>sverka.config.ts</code>, executed during the site deploy.
  </p>
  {[data.self].map((c) => (
    <section class={`pipeline ${chip(overall(c))}`}>
      <header>
        <span class={`badge ${chip(overall(c))}`}>{overall(c)}</span>
        <strong>{c.id}</strong>
        <span class="meta">{fmtMs(c.run?.durationMs)}</span>
        {reportHref(c) ? (
          <a class="meta" href={reportHref(c)}>full report →</a>
        ) : null}
      </header>
      {c.run?.data?.steps ? (
        <ol class="steps">
          {c.run.data.steps.map((s) => (
            <li class={`step ${chip(s.status)}`}>
              <span class={`dot ${chip(s.status)}`} />
              <code>{s.stepId}</code>
              <span class="meta">{fmtMs(s.durationMs)}</span>
              {s.error || s.stdout || s.stderr ? (
                <details>
                  <summary>{s.error ?? "output"}</summary>
                  {s.stdout ? <pre>{s.stdout}</pre> : null}
                  {s.stderr ? <pre class="err">{s.stderr}</pre> : null}
                </details>
              ) : null}
            </li>
          ))}
        </ol>
      ) : (
        <pre class="err">{c.outputTail || "no output captured"}</pre>
      )}
    </section>
  ))}

  <h2>Examples</h2>
  <p class="meta">
    Real <code>sverka run</code> against the projects in
    <code>examples/</code> via the published <code>@sverka/cli</code> — each
    is designed to produce a known pipeline state.
  </p>
  {data.examples.map((c) => (
    <section class={`pipeline ${chip(overall(c))}`}>
      <header>
        <span class={`badge ${chip(overall(c))}`}>{overall(c)}</span>
        <strong>examples/{c.id}</strong>
        <span class="meta">{fmtMs(c.run?.durationMs)}</span>
        {reportHref(c) ? (
          <a class="meta" href={reportHref(c)}>full report →</a>
        ) : null}
      </header>
      {c.run?.data?.steps ? (
        <ol class="steps">
          {c.run.data.steps.map((s) => (
            <li class={`step ${chip(s.status)}`}>
              <span class={`dot ${chip(s.status)}`} />
              <code>{s.stepId}</code>
              <span class="meta">{fmtMs(s.durationMs)}</span>
              {s.error || s.stdout || s.stderr ? (
                <details>
                  <summary>{s.error ?? "output"}</summary>
                  {s.stdout ? <pre>{s.stdout}</pre> : null}
                  {s.stderr ? <pre class="err">{s.stderr}</pre> : null}
                </details>
              ) : null}
            </li>
          ))}
        </ol>
      ) : (
        <pre class="err">{c.outputTail || "no output captured"}</pre>
      )}
    </section>
  ))}
  </>
  )}
</StarlightPage>

<style>
  .meta {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .pipeline {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin: 0.75rem 0 1.5rem;
  }
  .pipeline.ok {
    border-left: 4px solid var(--sl-color-green);
  }
  .pipeline.fail {
    border-left: 4px solid var(--sl-color-red);
  }
  .pipeline header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .badge {
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge.ok {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }
  .badge.fail {
    background: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
  }
  .badge.skip {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }
  .steps {
    list-style: none;
    padding-left: 0;
    margin-top: 0.75rem;
  }
  .step {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.2rem 0;
    flex-wrap: wrap;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex: none;
  }
  .dot.ok {
    background: var(--sl-color-green);
  }
  .dot.fail {
    background: var(--sl-color-red);
  }
  .dot.skip {
    background: var(--sl-color-gray-4);
  }
  .step details {
    flex-basis: 100%;
  }
  .step summary {
    color: var(--sl-color-red-high);
    cursor: pointer;
    font-size: 0.8rem;
  }
  .step pre {
    font-size: 0.75rem;
    max-height: 16rem;
    overflow: auto;
  }
  .step pre.err {
    color: var(--sl-color-red-high);
  }
</style>
