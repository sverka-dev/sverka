---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

interface Capture {
  id: string;
  exitCode: number;
  run?: { data?: { status: string }; durationMs?: number };
  reportFile?: string;
}
interface PipelineData {
  generatedAt: string;
  commit: string;
  self: Capture;
  examples: Capture[];
}
// The data file is generated by `bun run docs:pipeline` before `astro
// build`. `import.meta.glob` tolerates its absence (empty result, no
// build failure) so plain `astro dev`/`check` still work.
const modules = import.meta.glob<{ default: PipelineData }>(
  "../generated/pipelines.json",
  { eager: true },
);
const data: PipelineData | null =
  Object.values(modules)[0]?.default ?? null;

const fmtMs = (ms?: number): string =>
  ms === undefined ? "—" : ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`;
const chip = (status?: string): string => {
  if (status === "succeeded" || status === "success") return "ok";
  if (status === "failed" || status === "failure" || status === "error")
    return "fail";
  return "skip"; // skipped, cancelled, unknown — neutral
};
const overall = (c: Capture): string =>
  c.run?.data?.status ?? (c.exitCode === 0 ? "success" : "failure");
// Reports are plain files in public/pipeline-reports/ — prefix with the
// configured base (Starlight only prefixes its own routes).
const reportHref = (c: Capture): string | undefined =>
  c.reportFile
    ? `${import.meta.env.BASE_URL}pipeline-reports/${c.reportFile}`
    : undefined;
const captures = (d: PipelineData): { label: string; c: Capture }[] => [
  { label: "sverka (this repo)", c: d.self },
  ...d.examples.map((c) => ({ label: `examples/${c.id}`, c })),
];
---

<StarlightPage frontmatter={{ title: "Pipeline reports" }}>
  {
    data === null ? (
      <p class="meta">
        No pipeline data — run <code>bun run docs:pipeline</code> to
        generate it (requires built workspace deps).
      </p>
    ) : null
  }
  {data && (
  <>
  <p class="meta">
    Generated {new Date(data.generatedAt).toUTCString()} · commit
    <code>{data.commit || "local"}</code>. Each report is a real
    <code>sverka run</code> executed during the site deploy — the full
    report includes the workflow DAG and SARIF findings.
  </p>
  <table>
    <thead>
      <tr>
        <th>Pipeline</th>
        <th>Status</th>
        <th>Duration</th>
        <th>Report</th>
      </tr>
    </thead>
    <tbody>
      {captures(data).map(({ label, c }) => (
        <tr>
          <td><code>{label}</code></td>
          <td><span class={`badge ${chip(overall(c))}`}>{overall(c)}</span></td>
          <td class="meta">{fmtMs(c.run?.durationMs)}</td>
          <td>
            {reportHref(c) ? (
              <a href={reportHref(c)}>open report →</a>
            ) : (
              <span class="meta">not produced</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  </>
  )}
</StarlightPage>

<style>
  .meta {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .badge {
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge.ok {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }
  .badge.fail {
    background: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
  }
  .badge.skip {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }
</style>
