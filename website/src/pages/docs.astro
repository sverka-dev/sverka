---
import Base from "../layouts/Base.astro";

const exampleCode = `import { defineWorkflow, pipeline, task, run } from "@sverka/sdk";

export default defineWorkflow({
  name: "verify",
  workflow: pipeline(
    task("lint", run({ command: "bun", args: ["run", "lint"] })),
    task("typecheck", run({ command: "bun", args: ["run", "typecheck"] })),
    task("test", run({ command: "bun", args: ["run", "test"] })),
  ),
});`;
---

<Base title="Docs — Sverka">
  <main>
    <h1>Documentation</h1>
    <p class="tagline">Everything you need to use Sverka.</p>

    <h2>Guides</h2>
    <ul>
      <li><a href="/getting-started">Getting Started</a> — install, init, run</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/workflow-api/overview.md">Workflow API</a> — pipeline, run, parallel, when, matrix</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/cli/overview.md">CLI Reference</a> — all commands and flags</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/checks/builtin.md">Check Providers</a> — built-in checks and SARIF extraction</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/compilers/github.md">GitHub Actions</a> · <a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/compilers/gitlab.md">GitLab CI</a> — compilation targets</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/findings/normalization.md">Findings</a> · <a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/user/policy/evaluation.md">Policy</a> — normalization, baselines, verdicts</li>
    </ul>

    <h2>Engineering docs</h2>
    <ul>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs">Architecture</a> — system design and package dependencies</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/adr">ADRs</a> — architecture decision records</li>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/engdocs/contributing">Contributing</a> — development setup and conventions</li>
    </ul>

    <h2>Specs</h2>
    <ul>
      <li><a href="https://github.com/sverka-dev/sverka/tree/main/specs">Spec tree</a> — numbered specs for every package</li>
    </ul>

    <h2>Examples</h2>
    <pre><code set:html={exampleCode}></code></pre>
  </main>
</Base>
