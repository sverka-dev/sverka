---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

interface Aggregate {
  label: string;
  totalRuns: number;
  successCount: number;
  avgTotalTokens: number;
  avgToolCalls: number;
  avgLlmCalls: number;
  avgExecutionTimeMs: number;
}
interface Comparison {
  baseline: string;
  candidate: string;
  deltaTokens: number;
  deltaToolCalls: number;
  deltaLlmCalls: number;
  deltaTimeMs: number;
  candidateBetter: boolean;
}
interface ArenaDigest {
  timestamp: string;
  commit?: string;
  config: { models: string[]; plugins: string[]; repetitions: number };
  aggregates: Aggregate[];
  analysis: { taskId: string; taskName: string; comparisons: Comparison[] }[];
}

// Committed snapshot — produced by `bun run docs:arena` from a local
// `sverka-arena run` (CI has no agent credentials). glob tolerates a
// missing file so plain `astro dev`/`check` still work.
const modules = import.meta.glob<{ default: ArenaDigest }>(
  "../data/arena-results.json",
  { eager: true },
);
const data: ArenaDigest | null = Object.values(modules)[0]?.default ?? null;

const fmtMs = (ms: number): string => `${(ms / 1000).toFixed(1)}s`;
const fmtDelta = (n: number, fmt: (n: number) => string): string =>
  n === 0 ? "0" : `${n > 0 ? "+" : "−"}${fmt(Math.abs(n))}`;
const deltaClass = (n: number, invert = true): string => {
  // For cost metrics negative delta = improvement (candidate cheaper).
  if (n === 0) return "flat";
  const good = invert ? n < 0 : n > 0;
  return good ? "good" : "bad";
};
---

<StarlightPage frontmatter={{ title: "Arena results" }}>
  {
    data === null ? (
      <p class="meta">
        No arena snapshot — run <code>sverka-arena run</code> locally,
        then <code>bun run docs:arena</code> and commit the digest.
      </p>
    ) : null
  }
  {data && (
  <>
  <p class="meta">
    Snapshot from {new Date(data.timestamp).toUTCString()} · commit
    <code>{data.commit || "?"}</code> · models:
    {data.config.models.map((m) => <code>{m}</code>)} · plugins:
    {data.config.plugins.map((p) => <code>{p}</code>)} · repetitions:{" "}
    {data.config.repetitions}
  </p>

  <h2>Aggregates</h2>
  <table>
    <thead>
      <tr>
        <th>Configuration</th>
        <th>Runs</th>
        <th>Success</th>
        <th>Avg tokens</th>
        <th>Avg tool calls</th>
        <th>Avg LLM calls</th>
        <th>Avg time</th>
      </tr>
    </thead>
    <tbody>
      {data.aggregates.map((a) => (
        <tr>
          <td><code>{a.label}</code></td>
          <td class="num">{a.totalRuns}</td>
          <td class="num">
            {a.successCount}/{a.totalRuns}
          </td>
          <td class="num">{a.avgTotalTokens.toLocaleString()}</td>
          <td class="num">{a.avgToolCalls}</td>
          <td class="num">{a.avgLlmCalls}</td>
          <td class="num">{fmtMs(a.avgExecutionTimeMs)}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Per-task deltas</h2>
  <p class="meta">
    Candidate vs baseline per task. Negative deltas mean the candidate
    used fewer tokens/calls/time — those cells are green.
  </p>
  <table>
    <thead>
      <tr>
        <th>Task</th>
        <th>Comparison</th>
        <th>Δ tokens</th>
        <th>Δ tool calls</th>
        <th>Δ LLM calls</th>
        <th>Δ time</th>
        <th>Verdict</th>
      </tr>
    </thead>
    <tbody>
      {data.analysis.flatMap((t) =>
        t.comparisons.map((c) => (
          <tr>
            <td>
              <code>{t.taskId}</code>{" "}
              <span class="meta">{t.taskName}</span>
            </td>
            <td>
              <code>{c.baseline}</code> <span class="meta">→</span>{" "}
              <code>{c.candidate}</code>
            </td>
            <td class={`num ${deltaClass(c.deltaTokens)}`}>
              {fmtDelta(c.deltaTokens, (n) => n.toLocaleString())}
            </td>
            <td class={`num ${deltaClass(c.deltaToolCalls)}`}>
              {fmtDelta(c.deltaToolCalls, String)}
            </td>
            <td class={`num ${deltaClass(c.deltaLlmCalls)}`}>
              {fmtDelta(c.deltaLlmCalls, String)}
            </td>
            <td class={`num ${deltaClass(c.deltaTimeMs)}`}>
              {fmtDelta(c.deltaTimeMs, fmtMs)}
            </td>
            <td>
              <span class={`badge ${c.candidateBetter ? "ok" : "fail"}`}>
                {c.candidateBetter ? "better" : "worse"}
              </span>
            </td>
          </tr>
        )),
      )}
    </tbody>
  </table>
  </>
  )}
</StarlightPage>

<style>
  .meta {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .good {
    color: var(--sl-color-green-high);
  }
  .bad {
    color: var(--sl-color-red-high);
  }
  .flat {
    color: var(--sl-color-gray-3);
  }
  .badge {
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge.ok {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }
  .badge.fail {
    background: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
  }
</style>
