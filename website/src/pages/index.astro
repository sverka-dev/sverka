---
import Base from "../layouts/Base.astro";

const workflowCode = `import { defineWorkflow, pipeline, task, run } from "@sverka/sdk";

export default defineWorkflow({
  name: "verify",
  workflow: pipeline(
    task("lint", run({ command: "bun", args: ["run", "lint"] })),
    task("typecheck", run({ command: "bun", args: ["run", "typecheck"] })),
    task("test", run({ command: "bun", args: ["run", "test"] })),
  ),
});`;

const quickStartCode = `# Install
bun add -g @sverka/cli

# Initialize a workflow config
sverka init

# See what would run
sverka plan

# Run verification locally
sverka execute

# Validate your config
sverka validate`;
---

<Base title="Sverka — Define checks once. Plan locally. Run anywhere.">
  <main>
    <section class="hero">
      <h1>Sverka</h1>
      <p class="tagline">Define checks once. Plan locally. Run anywhere.</p>
      <div class="cta">
        <a class="cta-primary" href="/getting-started">Get Started</a>
        <a class="cta-secondary" href="https://github.com/sverka-dev/sverka">GitHub</a>
      </div>
    </section>

    <section>
      <p>
        A composable workflow SDK, local CI runtime, and multi-target compiler
        for software verification. Write verification workflows in TypeScript,
        run them locally with Docker or Podman, and compile to GitHub Actions
        or GitLab CI.
      </p>

      <pre><code set:html={workflowCode}></code></pre>
    </section>

    <section class="features">
      <div class="feature">
        <h3>TypeScript-first</h3>
        <p>Composable workflows as code. No YAML.</p>
      </div>
      <div class="feature">
        <h3>Local execution</h3>
        <p>Docker, Podman, host processes, remote APIs.</p>
      </div>
      <div class="feature">
        <h3>Plan before running</h3>
        <p>Generate a verification plan. See what will run.</p>
      </div>
      <div class="feature">
        <h3>Multi-target</h3>
        <p>Compile to GitHub Actions, GitLab CI, Earthly.</p>
      </div>
      <div class="feature">
        <h3>Normalized findings</h3>
        <p>One model for all tool outputs. SARIF compatible.</p>
      </div>
      <div class="feature">
        <h3>Deterministic replay</h3>
        <p>Locked images, locked inputs, reproducible runs.</p>
      </div>
    </section>

    <section>
      <h2>Quick start</h2>
      <pre><code set:html={quickStartCode}></code></pre>
    </section>

    <section>
      <h2>How it works</h2>
      <p>
        Sverka takes your TypeScript workflow definition, discovers your
        project context, and produces a canonical Plan IR. That plan can be
        executed locally or compiled to any supported CI target.
      </p>
      <p>
        The canonical source of truth is the Sverka workflow and its Plan IR —
        not GitHub Actions or GitLab CI.
      </p>
    </section>
  </main>
</Base>
