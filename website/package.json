{
  "name": "sverka-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun run sync-docs && vite dev",
    "build": "bun run sync-docs && bun run docs:search && bun run docs:pipeline && vite build && bun scripts/finalize-output.ts",
    "preview": "vite preview",
    "check": "bun scripts/gen-route-tree.ts && tsc --noEmit",
    "test": "bun test",
    "sync-docs": "bun scripts/sync-docs.ts",
    "docs:arena": "bun scripts/update-arena-results.ts",
    "docs:board": "bun scripts/update-arena-board.ts",
    "docs:pipeline": "bun scripts/gen-pipeline-data.ts",
    "arena": "bun run server/arena-server.ts",
    "docs:search": "bun scripts/gen-search-index.ts"
  },
  "dependencies": {
    "@sverka/playground": "0.2.28",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/start-static-server-functions": "1.167.43",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "nitro": "3.0.260903-beta",
    "srvx": "^1.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
