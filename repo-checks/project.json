{
  "name": "repo-checks",
  "targets": {
    "spell": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cspell lint --no-progress",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["{workspaceRoot}/**/*", "{workspaceRoot}/cspell.json"],
      "cache": true
    },
    "secrets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "secretlint \"**/*\"",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/**/*",
        "{workspaceRoot}/.secretlintignore",
        "{workspaceRoot}/.secretlintrc.json"
      ],
      "cache": true
    },
    "deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip",
        "cwd": "{workspaceRoot}"
      },
      "inputs": ["{workspaceRoot}/**/*", "{workspaceRoot}/knip.json"],
      "cache": true
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "markdownlint-cli2",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/.markdownlint.json",
        "{workspaceRoot}/.markdownlintignore"
      ],
      "cache": true
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check .",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/**/*",
        "{workspaceRoot}/.prettierrc",
        "{workspaceRoot}/.prettierignore"
      ],
      "cache": true
    },
    "actionlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 && \"$(go env GOPATH)/bin/actionlint\" .github/workflows/*.yml",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/.github/workflows/*.yml",
        "{workspaceRoot}/.github/workflows/*.yaml"
      ],
      "cache": true
    }
  }
}
